---
import "../styles/global.css";
import { STUDIO } from "../config";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "CHALCO ED es un estudio boutique de post-producción, diseño de movimiento y narrativa cinematográfica premium.",
} = Astro.props;
---

<!doctype html>
<html class="dark" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts and Icons -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background text-on-background font-body selection:bg-primary/30"
  >
    <!-- TopNavBar -->
    <nav
      class="fixed top-0 w-full z-50 bg-surface/75 backdrop-blur-lg border-b border-white/5 shadow-sm transition-all duration-300"
    >
      <div
        class="flex justify-between items-center px-6 md:px-12 py-5 max-w-7xl mx-auto"
      >
        <a
          class="font-headline text-lg md:text-xl font-bold tracking-tighter text-primary hover:text-white transition-colors duration-300"
          href="/"
        >
          {STUDIO.name}
        </a>

        <div class="hidden md:flex gap-8 items-center">
          <a
            class="text-sm font-semibold text-on-surface-variant hover:text-primary transition-all duration-300 hover:scale-105"
            href="/#reels-grid">Reels</a
          >
          <a
            class="text-sm font-semibold text-on-surface-variant hover:text-primary transition-all duration-300 hover:scale-105"
            href="/#proyectos">Proyectos</a
          >
          <a
            class="text-sm font-semibold text-on-surface-variant hover:text-primary transition-all duration-300 hover:scale-105"
            href="/#proceso">Proceso</a
          >
          <a href="/#contacto" class="bg-primary-container hover:bg-primary-container/85 text-on-primary-container px-6 py-2.5 rounded-full text-xs font-bold tracking-wider uppercase active:scale-95 transition-all shadow-lg shadow-primary-container/15 hover:shadow-primary-container/25">Contacto</a>
        </div>

        <button
          class="md:hidden text-primary hover:text-white transition-colors"
          id="mobile-menu-btn"
          aria-label="Abrir menú"
        >
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>

      <!-- Mobile Menu overlay -->
      <div
        id="mobile-menu"
        class="hidden absolute top-full left-0 w-full bg-surface-container/95 backdrop-blur-xl border-b border-white/5 py-8 px-6 flex flex-col gap-6 shadow-2xl"
      >
        <a
          class="text-lg font-semibold text-on-surface-variant hover:text-primary transition-colors py-2"
          href="/#reels-grid">Reels</a
        >
        <a
          class="text-lg font-semibold text-on-surface-variant hover:text-primary transition-colors py-2"
          href="/#proyectos">Proyectos</a
        >
        <a
          class="text-lg font-semibold text-on-surface-variant hover:text-primary transition-colors py-2"
          href="/#proceso">Proceso</a
        >
        <a href="/#contacto" class="bg-primary-container text-on-primary-container py-3.5 rounded-xl text-sm font-bold tracking-wider uppercase w-full block text-center">Contacto</a>
      </div>
    </nav>

    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="w-full py-16 bg-surface-container-lowest border-t border-white/5"
    >
      <div
        class="flex flex-col md:flex-row justify-between items-center px-6 md:px-12 max-w-7xl mx-auto gap-8"
      >
        <div>
          <a
            class="font-headline text-xl text-primary font-extrabold hover:text-white transition-colors"
            href="/"
          >
            {STUDIO.name}
          </a>
          <p class="text-xs text-on-tertiary-fixed-variant mt-2 font-mono">
            © 2026 {STUDIO.name}. Todos los derechos reservados.
          </p>
        </div>
        <div class="flex gap-8">
          <a
            class="text-sm text-on-tertiary-fixed-variant hover:text-secondary transition-colors"
            href="https://github.com/PaulChalco"
            target="_blank"
            rel="noopener noreferrer">Github</a
          >
          <a
            class="text-sm text-on-tertiary-fixed-variant hover:text-secondary transition-colors"
            href="https://www.linkedin.com/in/paulchalcofx"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
          <a
            class="text-sm text-on-tertiary-fixed-variant hover:text-secondary transition-colors"
            href="https://vimeo.com/user137488340?fl=pp&fe=sh"
            target="_blank"
            rel="noopener noreferrer">Vimeo</a
          >
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      const mobileBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");

      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener("click", () => {
          mobileMenu.classList.toggle("hidden");
          const isHidden = mobileMenu.classList.contains("hidden");
          mobileBtn.innerHTML = `<span class="material-symbols-outlined">${isHidden ? "menu" : "close"}</span>`;
        });

        // Close when clicking layout links
        mobileMenu.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            mobileBtn.innerHTML =
              '<span class="material-symbols-outlined">menu</span>';
          });
        });
      }

      // Scroll reveal script
      const observerOptions = {
        threshold: 0.08,
        rootMargin: "0px 0px -40px 0px",
      };

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            revealObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);

      function setupScrollReveal() {
        document.querySelectorAll(".reveal").forEach((el) => {
          revealObserver.observe(el);
        });
      }

      setupScrollReveal();
      document.addEventListener("astro:page-load", setupScrollReveal);
    </script>
  </body>
</html>
